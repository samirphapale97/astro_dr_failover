# ──────────────────────────────────────────────────────────────────────────
# Environment Configuration for Real AWS / Slack / Astro Testing
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ──────────────────────────────────────────────────────────────────────────

# ── AWS ──────────────────────────────────────────────────────────────────
# Your AWS credentials (or use `aws configure` instead)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# ── DR Config ────────────────────────────────────────────────────────────
ASTRO_DR_PRIMARY_REGION=us-east-1
ASTRO_DR_DR_REGION=us-east-2

# SSM parameter name that tracks the active region
ASTRO_DR_ACTIVE_REGION_SSM_PARAM=/airflow/active_region

# Secret name template — {region} is replaced at runtime
ASTRO_DR_SECRET_NAME_TEMPLATE=/airflow/config/{region}/app_config

# ── Slack ────────────────────────────────────────────────────────────────
# Create at: https://api.slack.com/messaging/webhooks
ASTRO_DR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
ASTRO_DR_SLACK_CHANNEL=#dr-failover-alerts

# ── Astronomer (Astro) ───────────────────────────────────────────────────
# Get from: Astro UI → Settings → API Keys
ASTRO_DR_ASTRO_API_KEY=your-astro-api-key
ASTRO_DR_ASTRO_DEPLOYMENT_ID=your-deployment-id
ASTRO_DR_ASTRO_API_URL=https://api.astronomer.io

# ── SQS Queue (created by Terraform) ────────────────────────────────────
# Fill this AFTER running `terraform apply`
SQS_QUEUE_URL=

# ── DynamoDB Tables (created by Terraform) ───────────────────────────────
# Fill these AFTER running `terraform apply`
STATE_TABLE_NAME=airflow-dr-prod-failover-state
LOCK_TABLE_NAME=airflow-dr-prod-failover-locks
